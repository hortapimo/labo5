# =======================================================
# Estilo 'Talk' con Grid y Soporte LaTeX
# =======================================================

# 1. Tamaños de fuente (estilo 'talk')
font.size: 15
axes.titlesize: 18
axes.labelsize: 16
xtick.labelsize: 14
ytick.labelsize: 14
legend.fontsize: 14
figure.titlesize: 20

# 2. Grosor de líneas y marcadores (mayor visibilidad)
lines.linewidth: 2.5
lines.markersize: 10
lines.markeredgewidth: 1.5

# 3. Configuración de la cuadrícula (Grid)
# Activa tanto el grid mayor como el menor
axes.grid: True
axes.grid.which: both
xtick.minor.visible: True
ytick.minor.visible: True

# Nota: matplotlib aplica el mismo alpha al grid mayor y menor desde el .mplstyle
grid.linestyle: --
grid.alpha: 0.7
grid.color: b0b0b0

figure.autolayout: True


font.family: serif